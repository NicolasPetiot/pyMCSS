<ROSETTASCRIPTS>
	<SCOREFXNS>
	</SCOREFXNS>
	<RESIDUE_SELECTORS>
        <Index name="to_mutate_A" resnums="%%resi%%A"/>
        <Index name="to_mutate_B" resnums="%%resi%%B"/>
        <Or name="to_mutate" selectors="to_mutate_A,to_mutate_B" />
	</RESIDUE_SELECTORS>
	<MOVERS>
        <MutateResidue name="mutate" residue_selector="to_mutate" new_res="%%new_res%%" preserve_atom_coords="false" />
        <InterfaceAnalyzerMover name="interface_analyzer" scorefxn="REF2015" pack_separated="true" pack_input="true" interface="A_B"/>
	</MOVERS>
	<PROTOCOLS>
        1 - Mutation from -parser:script_vars resi=(...) new_res=(...)
        <Add mover_name="mutate" />

        2 - Interface Analyzer:
        <Add mover_name="interface_analyzer" />
	</PROTOCOLS>
	<OUTPUT />
</ROSETTASCRIPTS>
